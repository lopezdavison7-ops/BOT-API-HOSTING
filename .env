# ============================================
# BOT-API-HOSTING - Configuración
# Powered by Alex Aguilar Gutiérrez
# ============================================

# --------------------------------------------
# SERVIDOR
# --------------------------------------------
PORT=3000
NODE_ENV=production
HOST_URL=https://tu-dominio.com

# --------------------------------------------
# BASE DE DATOS (MySQL de HidenCloud)
# Instrucciones: En HidenCloud Panel ve a
# Management > Databases > Create Database
# Anota los datos que te dan y pégalos aquí
# --------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=tu_nombre_base_datos

# --------------------------------------------
# AUTENTICACIÓN JWT
# IMPORTANTE: Genera una clave secreta segura
# Puedes usar: https://randomkeygen.com/
# o simplemente una frase larga aleatoria
# --------------------------------------------
JWT_SECRET=cambia_esto_por_una_clave_super_secreta_de_64_caracteres_o_mas
JWT_EXPIRES_IN=7d

# --------------------------------------------
# PAYPAL (Para recarga de Coins)
# 1. Ve a https://developer.paypal.com/
# 2. Crea una App en Sandbox para pruebas
# 3. Cuando funcione, cambia a Live Mode
# 4. Copia Client ID y Secret aquí
# Email donde recibes pagos: l29472954@gmail.com
# --------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=tu_paypal_client_id_aqui
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_aqui
PAYPAL_WEBHOOK_URL=https://tu-dominio.com/api/coins/webhook

# --------------------------------------------
# ADMIN INICIAL (Se crea automáticamente)
# Este usuario tendrá permisos de administrador
# --------------------------------------------
ADMIN_EMAIL=l29472954@gmail.com
ADMIN_PASSWORD=luis123
ADMIN_USERNAME=admin

# --------------------------------------------
# PRECIOS DE COINS (USD)
# Formato: COINS_PRECIO_100=5.00
# --------------------------------------------
COINS_PRECIO_100=5.00
COINS_PRECIO_250=10.00
COINS_PRECIO_500=18.00
COINS_PRECIO_1000=30.00
COINS_PRECIO_2500=65.00
COINS_PRECIO_5000=120.00

# --------------------------------------------
# PLANES DE SERVIDOR (Coins)
# --------------------------------------------
PLAN_BASICO_COINS=50
PLAN_BASICO_BOTS=1
PLAN_BASICO_DIAS=30

PLAN_ESTANDAR_COINS=100
PLAN_ESTANDAR_BOTS=2
PLAN_ESTANDAR_DIAS=30

PLAN_PRO_COINS=200
PLAN_PRO_BOTS=5
PLAN_PRO_DIAS=30

PLAN_ULTRA_COINS=400
PLAN_ULTRA_BOTS=10
PLAN_ULTRA_DIAS=30